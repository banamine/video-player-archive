name: RSS Playlist Archiver

on:
  schedule:
    - cron: '0 * * * *' # Runs every hour at minute 0
  workflow_dispatch: # Allows manual triggering from the Actions tab

jobs:
  build-and-archive:
    runs-on: ubuntu-latest
    permissions:
      contents: write # Required to push commits back to the repo

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js (For RSS Parsing)
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install All Dependencies
        run: npm install

      - name: Run Playlist Generator Script
        run: node scripts/generate_playlists.js

      - name: Commit and Push Changes
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action Archiver"
          
          # Stage both the playlist assets and the tracking database
          git add playlists/ data/
          
          # Only commit if changes exist to prevent workflow errors
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-update: Sync latest RSS playlists & database" && git push)
